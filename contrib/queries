 10.233.241.131 | del    |   584
 10.233.240.129 | del    |   556
 10.233.241.129 | del    |   555
(8 строк)

*/

-- 3. How many prefixes per vrf.
 select vpn_rd, count(vpn_rd) 
 from l3vpnv4_curr l, base_attrs b 
 where l.base_attr_hash = b.base_attr_hash 
 and vpn_rd like '%205%' group by vpn_rd;
 select l.peer_ip, count(l.peer_ip) from ucast_pfx_curr l, base_attrs b 
 where l.base_attr_hash = b.base_attr_hash 
 and community_list like '%3333:38%' 
 and (peer_ip like '10.233.24_.131' or peer_ip like '10.233.24_.129') 
 group by l.peer_ip order by  peer_ip;

/*

    peer_ip     | count 
----------------+-------
 10.233.240.129 |    28
 10.233.240.131 |    23
 10.233.241.129 |    33
 10.233.241.131 |    27
(4 строки)

*/
 
-- 3.1. How many prefixes per asbr.
 select l.router_id, l.peer_ip, count(community_list) 
 from ucast_pfx_curr l, base_attrs b 
 where l.base_attr_hash = b.base_attr_hash and community_list like '%3333:38%' 
