-- 1. How many routes per vrf were announced.
-- 2. How many routes per vrf were withrawn.
 select l.peer_ip, l.action, count(l.action) 
 from ucast_pfx l, base_attrs b 
 where l.base_attr_hash = b.base_attr_hash 
 and (peer_ip like '10.233.24_.131' or peer_ip like '10.233.24_.129') 
 group by l.action, l.peer_ip ;

/*
